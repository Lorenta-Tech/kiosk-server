{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/auth/google": {
            "post": {
                "description": "Accepts a Google ID token from the frontend (obtained after",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Authenticate with Google OAuth",
                "parameters": [
                    {
                        "description": "Google ID token",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.GoogleAuthRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.AuthResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/files/jobs/recent": {
            "get": {
                "description": "Returns the last 10 print jobs for the authenticated user.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "jobs"
                ],
                "summary": "Get recent print jobs for the current user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.RecentPrintJobsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/files/jobs/token": {
            "post": {
                "description": "The kiosk calls this with the token the user entered.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "jobs"
                ],
                "summary": "Retrieve a print job by 6-digit token",
                "parameters": [
                    {
                        "description": "6-digit token",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.GetJobByTokenRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.TokenJobResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/files/upload/confirm": {
            "post": {
                "description": "Called after files are uploaded directly to S3.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "uploads"
                ],
                "summary": "Confirm uploaded files and set print options",
                "parameters": [
                    {
                        "description": "Print options per file",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.ConfirmUploadRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.ConfirmUploadResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/files/upload/init": {
            "post": {
                "description": "Creates an upload session and returns presigned S3 PUT URLs",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "uploads"
                ],
                "summary": "Initialise a file upload session",
                "parameters": [
                    {
                        "description": "Files to upload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.InitUploadRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/models.InitUploadResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.AuthResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/models.UserInfo"
                }
            }
        },
        "models.ConfirmFileRequest": {
            "type": "object",
            "required": [
                "copies",
                "file_id",
                "num_of_pages",
                "page_layout",
                "page_range",
                "printing_mode",
                "printing_side"
            ],
            "properties": {
                "copies": {
                    "type": "integer",
                    "minimum": 1
                },
                "file_id": {
                    "type": "string"
                },
                "num_of_pages": {
                    "type": "integer",
                    "minimum": 1
                },
                "page_layout": {
                    "type": "integer",
                    "minimum": 1
                },
                "page_range": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                },
                "printing_mode": {
                    "type": "string",
                    "enum": [
                        "monochromatic",
                        "color"
                    ]
                },
                "printing_side": {
                    "type": "string",
                    "enum": [
                        "single_side",
                        "double_side"
                    ]
                }
            }
        },
        "models.ConfirmFileResponse": {
            "type": "object",
            "properties": {
                "copies": {
                    "type": "integer"
                },
                "file_id": {
                    "type": "string"
                },
                "file_name": {
                    "type": "string"
                },
                "num_of_pages": {
                    "type": "integer"
                },
                "price": {
                    "type": "number"
                }
            }
        },
        "models.ConfirmUploadRequest": {
            "type": "object",
            "required": [
                "files",
                "session_id"
            ],
            "properties": {
                "files": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/models.ConfirmFileRequest"
                    }
                },
                "session_id": {
                    "type": "string"
                }
            }
        },
        "models.ConfirmUploadResponse": {
            "type": "object",
            "properties": {
                "files": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.ConfirmFileResponse"
                    }
                },
                "session_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "total_amount": {
                    "type": "number"
                },
                "total_sheets": {
                    "type": "integer"
                }
            }
        },
        "models.GetJobByTokenRequest": {
            "type": "object",
            "required": [
                "token"
            ],
            "properties": {
                "token": {
                    "type": "integer",
                    "maximum": 999999,
                    "minimum": 100000
                }
            }
        },
        "models.GoogleAuthRequest": {
            "type": "object",
            "required": [
                "id_token"
            ],
            "properties": {
                "id_token": {
                    "type": "string"
                }
            }
        },
        "models.InitFileRequest": {
            "type": "object",
            "required": [
                "content_type",
                "file_name"
            ],
            "properties": {
                "content_type": {
                    "type": "string",
                    "enum": [
                        "application/pdf"
                    ]
                },
                "file_name": {
                    "type": "string"
                }
            }
        },
        "models.InitFileResponse": {
            "type": "object",
            "properties": {
                "file_id": {
                    "type": "string"
                },
                "file_name": {
                    "type": "string"
                },
                "staging_key": {
                    "type": "string"
                },
                "upload_url": {
                    "type": "string"
                }
            }
        },
        "models.InitUploadRequest": {
            "type": "object",
            "required": [
                "files"
            ],
            "properties": {
                "files": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/models.InitFileRequest"
                    }
                }
            }
        },
        "models.InitUploadResponse": {
            "type": "object",
            "properties": {
                "expires_at": {
                    "type": "string"
                },
                "files": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.InitFileResponse"
                    }
                },
                "session_id": {
                    "type": "string"
                },
                "token": {
                    "type": "integer"
                }
            }
        },
        "models.PrintJob": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "files": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.PrintJobFile"
                    }
                },
                "session_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "total_amount": {
                    "type": "number"
                },
                "total_sheets": {
                    "type": "integer"
                }
            }
        },
        "models.PrintJobFile": {
            "type": "object",
            "properties": {
                "copies": {
                    "type": "integer"
                },
                "download_url": {
                    "description": "only set for token lookup",
                    "type": "string"
                },
                "file_id": {
                    "type": "string"
                },
                "file_name": {
                    "type": "string"
                },
                "file_status": {
                    "type": "string"
                },
                "number_of_pages": {
                    "type": "integer"
                },
                "page_layout": {
                    "type": "integer"
                },
                "page_range": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "price": {
                    "type": "number"
                },
                "printing_mode": {
                    "type": "string"
                },
                "printing_side": {
                    "type": "string"
                }
            }
        },
        "models.RecentPrintJobsResponse": {
            "type": "object",
            "properties": {
                "jobs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.PrintJob"
                    }
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "models.TokenJobResponse": {
            "type": "object",
            "properties": {
                "job": {
                    "$ref": "#/definitions/models.PrintJob"
                }
            }
        },
        "models.UserInfo": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "utils.Envelope": {
            "type": "object",
            "additionalProperties": {}
        }
    }
}